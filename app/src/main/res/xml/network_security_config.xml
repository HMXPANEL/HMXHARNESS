<?xml version="1.0" encoding="utf-8"?>
<!-- Credential-bearing traffic is TLS-only by default. Loopback development
     servers (local AI providers, local MCP servers) remain reachable over plain
     HTTP, but no arbitrary remote host can receive credentials in cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
